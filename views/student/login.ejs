<!DOCTYPE html>
<html>
<head>
    <title>Student Login</title>
    <link rel="stylesheet" href="/style.css">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body>
    <div class="container">
        <header class="hover-lift">
            <h1>Student Login</h1>
            <a class="btn large-text" href="/">Back to Home</a>
        </header>

        <% if (error) { %>
            <div class="error large-text"><%= error %></div>
        <% } %>

        <div class="card hover-lift">
            <h2 class="card-title">Access Your Details</h2>
            <p class="large-text" style="margin-bottom: 25px; color: #6c757d;">
                Enter your roll number to view your student details
            </p>

            <form action="/student/login" method="POST" class="mt-25">
                <input type="number" name="roll" placeholder="Enter Roll Number" required class="large-text">
                <br>
                <br>
                <button type="submit" class="btn large-text">View Details</button>
            </form>
        </div>

        <div class="card text-center hover-lift">
            <h3 class="card-title">Need Help?</h3>
            <p class="large-text">Contact admin to retrieve your roll number if you don't remember it.</p>
        </div>
    </div>
</body>
</html>
