<!DOCTYPE html>
<html>
<head>
    <title>Admin Dashboard</title>
    <link rel="stylesheet" href="/style.css">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body>
    <div class="container">
        <header class="hover-lift">
            <h1>Student Management System</h1>
            <div>
                <a class="btn large-text" href="/">Home</a>
                <a class="btn danger large-text" href="/admin/logout">Logout</a>
            </div>
        </header>

        <% if (typeof error !== 'undefined' && error) { %>
            <div class="error large-text"><%= error %></div>
        <% } %>

        <% if (typeof success !== 'undefined' && success) { %>
            <div class="success large-text"><%= success %></div>
        <% } %>

        <!-- Summary Cards -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 25px; margin-bottom: 40px;">
            <!-- Total Students Card -->
            <div class="card hover-lift" style="text-align: center; background: linear-gradient(135deg, #3b82f6, #1d4ed8); color: white; padding: 35px;">
                <h3 class="card-title" style="color: white; font-size: 1.3rem;">Total Students</h3>
                <div class="very-large-text" style="font-size: 2.5rem; font-weight: 700; margin: 15px 0;">
                    <%= totalStudents %>
                </div>
                <p style="opacity: 0.9; font-size: 1.1rem;">Students Enrolled</p>
            </div>

            <!-- Average Marks Card -->
            <div class="card hover-lift" style="text-align: center; background: linear-gradient(135deg, #10b981, #059669); color: white; padding: 35px;">
                <h3 class="card-title" style="color: white; font-size: 1.3rem;">Average Marks</h3>
                <div class="very-large-text" style="font-size: 2.5rem; font-weight: 700; margin: 15px 0;">
                    <%= averageMarks %>
                </div>
                <p style="opacity: 0.9; font-size: 1.1rem;">Class Performance</p>
            </div>

            <!-- Highest Marks Card -->
            <div class="card hover-lift" style="text-align: center; background: linear-gradient(135deg, #8b5cf6, #7c3aed); color: white; padding: 35px;">
                <h3 class="card-title" style="color: white; font-size: 1.3rem;">Highest Marks</h3>
                <div class="very-large-text" style="font-size: 2.5rem; font-weight: 700; margin: 15px 0;">
                    <%= highestMarks %>
                </div>
                <p style="opacity: 0.9; font-size: 1.1rem;">Top Score</p>
            </div>

            <!-- Courses Offered Card -->
            <div class="card hover-lift" style="text-align: center; background: linear-gradient(135deg, #f59e0b, #d97706); color: white; padding: 35px;">
                <h3 class="card-title" style="color: white; font-size: 1.3rem;">Courses Offered</h3>
                <div class="very-large-text" style="font-size: 2.5rem; font-weight: 700; margin: 15px 0;">
                    <%= coursesOffered %>
                </div>
                <p style="opacity: 0.9; font-size: 1.1rem;">Different Programs</p>
            </div>
        </div>

        <div class="card hover-lift">
            <h2 class="card-title">Add New Student</h2>
            <form action="/admin/add" method="POST">
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px;">
                    <input type="text" name="name" placeholder="Enter Full Name" required class="large-text">
                    <input type="number" name="roll" placeholder="Enter Roll Number" required class="large-text">
                    <input type="text" name="course" placeholder="Enter Course" required class="large-text">
                    <input type="number" name="marks" placeholder="Enter Marks (0-100)" min="0" max="100" required class="large-text">
                </div>
                <button type="submit" class="btn large-text mt-25">Add Student</button>
            </form>
        </div>

        <div class="card hover-lift">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px; flex-wrap: wrap; gap: 15px;">
                <h2 class="card-title">All Students</h2>
                <div style="display: flex; gap: 15px; align-items: center; flex-wrap: wrap;">
                    <a href="/admin/attendance" class="btn large-text">
                        📅 Mark Attendance
                    </a>
                    <a href="/admin/attendance/report" class="btn large-text">
                        📊 View Reports
                    </a>
                    <a href="/admin/export-excel" class="btn success large-text">
                        📥 Download Excel
                    </a>
                    <div class="search-form">
                        <form method="GET" action="/admin/dashboard" style="display: flex; gap: 15px; align-items: center; flex-wrap: wrap;">
                            <input type="text" name="search" placeholder="Search by name or roll" class="large-text"
                                   value="<%= typeof search !== 'undefined' ? search : '' %>">
                            <button type="submit" class="btn large-text">Search</button>
                            <% if (typeof search !== 'undefined' && search) { %>
                                <a href="/admin/dashboard" class="btn warning large-text">Clear</a>
                            <% } %>
                        </form>
                    </div>
                </div>
            </div>

            <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            <th class="large-text">Roll Number</th>
                            <th class="large-text">Name</th>
                            <th class="large-text">Course</th>
                            <th class="large-text">Marks</th>
                            <th class="large-text">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% students.forEach(s => { %>
                            <tr>
                                <td class="large-text">#<%= s.roll %></td>
                                <td class="large-text"><strong><%= s.name %></strong></td>
                                <td class="large-text"><%= s.course %></td>
                                <td class="large-text">
                                    <span class="marks-badge
                                        <% if (s.marks >= 80) { %>marks-high<%
                                        } else if (s.marks >= 60) { %>marks-medium<%
                                        } else { %>marks-low<% } %>">
                                        <%= s.marks %>%
                                    </span>
                                </td>
                                <td class="action-buttons">
                                    <a class="btn large-text" href="/admin/edit/<%= s._id %>">Edit</a>
                                    <form action="/admin/delete/<%= s._id %>" method="POST" style="display: inline;">
                                        <button type="submit" class="btn danger large-text btn-sm"
                                                onclick="return confirm('Are you sure you want to delete this student?')">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>

            <% if (students.length === 0) { %>
                <div class="text-center" style="padding: 40px; color: #6c757d;">
                    <h3 class="large-text">No students found.</h3>
                    <p class="large-text">Add students using the form above to see them listed here.</p>
                </div>
            <% } %>
        </div>
    </div>
</body>
</html>
